[Unit]
Description=Acquisizione e pubblicazione BufRom
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Percorsi proposti per la produzione; installare prima il programma e la configurazione.
User=wreport
Group=wreport
WorkingDirectory=/var/lib/wreport
UMask=0077
ExecStart=/opt/bufrom/current/scripts/update.sh /etc/bufrom/bufrom.conf
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
